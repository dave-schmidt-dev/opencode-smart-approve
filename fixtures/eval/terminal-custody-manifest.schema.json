{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "classifier-terminal-custody/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "generatedAt", "terminal", "candidateManifestHash", "developmentReportHash", "developmentFailureCode", "status", "providerCalls", "privateByteReads", "namedCorpusRoles", "custodyTransition", "ledgerState", "manifestHash"],
  "properties": {
    "schemaVersion": { "const": "classifier-terminal-custody/v1" },
    "generatedAt": { "type": "string", "minLength": 1 },
    "terminal": { "const": "development_failed" },
    "candidateManifestHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "developmentReportHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "developmentFailureCode": { "type": "string", "minLength": 1 },
    "status": { "const": "not_created" },
    "providerCalls": { "const": 0 },
    "privateByteReads": { "const": 0 },
    "namedCorpusRoles": { "const": 0 },
    "custodyTransition": { "const": "none" },
    "ledgerState": { "const": "not_created" },
    "manifestHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
