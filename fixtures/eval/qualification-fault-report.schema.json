{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "classifier-qualification-faults/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "generatedAt", "executionMode", "observations", "observationIDs", "invalidRunCount", "classifierDenominator", "boundaryCounts", "latencyP95Ms", "sharedObservationIDs"],
  "properties": {
    "schemaVersion": { "const": "classifier-qualification-faults/v1" },
    "generatedAt": { "type": "string", "minLength": 1 },
    "executionMode": { "const": "synthetic" },
    "observations": { "type": "array", "items": { "$ref": "#/$defs/observation" } },
    "observationIDs": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "invalidRunCount": { "type": "integer", "minimum": 0 },
    "classifierDenominator": { "const": 0 },
    "boundaryCounts": { "type": "object", "additionalProperties": false, "required": ["create", "prompt", "parse", "tool", "permission", "timeout", "capacity", "reply"], "properties": { "create": { "type": "integer", "minimum": 0 }, "prompt": { "type": "integer", "minimum": 0 }, "parse": { "type": "integer", "minimum": 0 }, "tool": { "type": "integer", "minimum": 0 }, "permission": { "type": "integer", "minimum": 0 }, "timeout": { "type": "integer", "minimum": 0 }, "capacity": { "type": "integer", "minimum": 0 }, "reply": { "type": "integer", "minimum": 0 } } },
    "latencyP95Ms": { "type": "number", "minimum": 0 },
    "sharedObservationIDs": { "type": "array", "maxItems": 0, "items": { "type": "string" } }
  },
  "$defs": {
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["observationID", "boundary", "route", "providerAttempted", "decision", "reasonCodes", "schemaValid", "metricEligible", "outcome", "terminalKind", "responseHash", "latencyMs"],
      "properties": {
        "observationID": { "type": "string", "minLength": 1, "maxLength": 200 },
        "boundary": { "enum": ["create", "prompt", "parse", "tool", "permission", "timeout", "capacity", "reply"] },
        "route": { "enum": ["deterministic", "reviewer"] },
        "providerAttempted": { "type": "boolean" },
        "decision": { "const": "manual" },
        "reasonCodes": { "type": "array", "minItems": 1, "maxItems": 8, "items": { "type": "string" } },
        "schemaValid": { "const": false },
        "metricEligible": { "const": false },
        "outcome": { "const": "invalid_run" },
        "terminalKind": { "type": "string" },
        "responseHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "latencyMs": { "type": "number", "minimum": 0 }
      }
    }
  }
}
